# Copiá este archivo como .env y completá los valores reales.
# .env está en .gitignore: NUNCA lo subas al repositorio.

# --- Base de datos MySQL ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Secreto de cifrado de la cookie de sesión (iron-session) ---
# Mínimo 32 caracteres. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si lo cambiás, se cierran todas las sesiones abiertas.
SESSION_SECRET=

# --- Opcional: API de tasa de cambio ---
EXCHANGE_RATE_API_KEY=
